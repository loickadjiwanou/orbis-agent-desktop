// orbis-agent.rc
// Embeds the UAC manifest and version resource into the binary.

#include <windows.h>

// ── UAC Manifest ────────────────────────────────────────────────────────────
1 RT_MANIFEST "orbis-agent.manifest"

// ── Version Info ─────────────────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Orbis\0"
            VALUE "FileDescription",  "Orbis Monitoring Agent\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "orbis-agent\0"
            VALUE "LegalCopyright",   "Copyright (C) 2024 Orbis\0"
            VALUE "OriginalFilename", "orbis-agent.exe\0"
            VALUE "ProductName",      "Orbis Agent\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
