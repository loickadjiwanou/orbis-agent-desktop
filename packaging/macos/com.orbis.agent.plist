<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.orbis.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/orbis-agent</string>
        <string>--config</string>
        <string>/etc/orbis-agent/config.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/orbis-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/orbis-agent.log</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
