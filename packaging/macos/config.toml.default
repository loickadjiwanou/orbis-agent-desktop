# Orbis Agent — configuration
# Edit this file before starting the agent for the first time.

[agent]
device_id = ""
token     = ""

[mqtt]
broker_host              = "YOUR_SERVER_HOST"
broker_port              = 8883
use_tls                  = true
ca_cert_path             = ""
register_secret          = "orbis_register_secret"
reconnect_delay_min_sec  = 1
reconnect_delay_max_sec  = 60
keepalive_sec            = 60

[heartbeat]
interval_sec = 30

[logs]
interval_sec = 60
levels       = ["error", "warning", "info"]

[plugins]
enabled     = true
plugins_dir = "/usr/local/lib/orbis-agent/plugins"

[buffer]
db_path = "/var/lib/orbis-agent/buffer.db"

[network_scanner]
enabled           = false
scan_interval_sec = 300
port_range        = "22,80,443,3389,5900"
